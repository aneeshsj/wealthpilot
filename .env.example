# WealthPilot runtime configuration. Copy to .env and fill in secrets.
# .env is ignored by Git; never commit credentials.

# Gemini is the active provider for this release.
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL="gemini/gemini-flash-lite-latest"
# Groq remains supported in code but is intentionally dormant.
# GROQ_API_KEY=
# GROQ_API_MODEL="openai/gpt-oss-120b"

# Optional provider-independent overrides.
# LLM_MODEL=
# LLM_API_KEY=
# LLM_API_BASE=

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
LLM_FALLBACK_ENABLED=false
# LLM_FALLBACK_PROVIDER=groq

# Langfuse observability (optional; tracing remains local when unset)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

DATA_DIR=data/wealthpilot
SQLITE_DB_PATH=wealthpilot.db
QDRANT_PATH=./qdrant_data
# Set QDRANT_URL for multi-process deployments; local QDRANT_PATH mode is single-process.
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=wealthpilot_policy_docs
# Local runs use the MCP memory transport so the protocol is exercised without
# a subprocess boundary. Set MCP_TRANSPORT=stdio for a separate MCP process.
MCP_TRANSPORT=in_process
MCP_POLICY_RESOURCE_URI=policy://fair-lending-standard
MCP_ENABLED=true
LOG_LEVEL=INFO
GRAPH_RECURSION_LIMIT=25
DSCR_TOLERANCE=0.05
AUTO_APPROVE_MAX_INR=2500000
HUMAN_SIGNOFF_THRESHOLD_INR=5000000
REVENUE_MISMATCH_PCT=10
FRAUD_HOLD_VARIANCE_PCT=25
MAX_GRAPH_REVISIONS=3
